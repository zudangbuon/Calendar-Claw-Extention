{
  "manifest_version": 3,
  "name": "USTH TKB to Google Calendar",
  "version": "2.3.0",
  "description": "Automatically syncs your USTH ERP timetable and exams to Google Calendar whenever Chrome starts.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "notifications",
    "identity",
    "identity.email",
    "browsingData"
  ],
  "host_permissions": [
    "https://erp.usth.edu.vn/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "95782835213-sg7vshpcu2mnu9crrf8aqvog493tgeiq.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.app.created"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "USTH TKB",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
